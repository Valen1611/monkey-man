# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.pnpm-store

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*key.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# secrets directory
secrets/
**/secrets/
!secrets/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database
*.db
*.db-journal

# Personal & custom parsers
personal-rules.js
apps/backend/listener/personal-rules.js
apps/backend/worker/rules/personal-rules.js
custom-parsers/*
!custom-parsers/.gitkeep
!custom-parsers/README.md
apps/backend/worker/sources/custom/*
!apps/backend/worker/sources/custom/.gitkeep
!apps/backend/worker/sources/custom/custom-source.example.js

# Raw email dumps & operational state
apps/backend/dumps/*
!apps/backend/dumps/.gitkeep
apps/backend/processed-message-ids.json
