# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*key.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# secrets & databases
secrets/
*.db
*.db-journal

# personal rules & custom sources
personal-rules.js
worker/rules/personal-rules.js
worker/sources/custom/*
!worker/sources/custom/.gitkeep
!worker/sources/custom/custom-source.example.js

# raw dumps & operational cache
dumps/
processed-message-ids.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
