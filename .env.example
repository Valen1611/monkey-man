# =====================================================================
# MONKEY-MAN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =====================================================================

# Server Ports
PORT=7070
FRONTEND_PORT=7071
NEXT_PUBLIC_API_URL=http://localhost:7070

# Google Cloud & Gmail Configuration
# The label ID in Gmail you want the worker to listen to
GOOGLE_LABEL_ID=your_gmail_label_id

# Cloud Pub/Sub Topic and Subscription
GOOGLE_PROJECT_ID=your_gcp_project_id
GOOGLE_TOPIC_NAME=projects/your_gcp_project_id/topics/your_topic_name
GOOGLE_PUBSUB_SUBSCRIPTION=your_subscription_name

# Service Account Key: Place your downloaded JSON in ./secrets/gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-key.json

# OAuth 2.0 Credentials (for Gmail API access)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# Optional Fallbacks
DEFAULT_WALLET_NAME="Checking Account"
# DEFAULT_WALLET_ID=

# =====================================================================
# API Secret Guard (REQUIRED for network-exposed deployments)
# =====================================================================
# The backend requires every request to include the header:
#   x-api-secret: <your-value>
# The frontend reads NEXT_PUBLIC_API_SECRET and sends it automatically.
#
# Generate a strong random string: openssl rand -hex 32
# Both values MUST match.
#
# ⚠️  If you expose this app to the internet without setting these,
#     anyone can read/modify/delete your financial data.
API_SECRET=change-me-to-a-strong-random-string
NEXT_PUBLIC_API_SECRET=change-me-to-a-strong-random-string

# =====================================================================
# CORS Origin (recommended for network-exposed deployments)
# =====================================================================
# Restrict which origins can call the backend API.
# Set this to your frontend URL (e.g. http://localhost:7071 or your domain).
# Leave unset to allow all origins (not recommended for public access).
#
# CORS_ORIGIN=http://localhost:7071
